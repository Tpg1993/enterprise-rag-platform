  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Enterprise RAG Operational Telemetry",
      "type": "row"
    },
    {
      "id": 2,
      "title": "RAG Request Throughput (Req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(rag_requests_total[1m])) by (strategy)",
          "legendFormat": "{{strategy}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 & P99 Request Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Token Consumption Throughput (Tokens/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(rag_tokens_total[1m])) by (type)",
          "legendFormat": "{{type}} tokens",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cumulative LLM Cost ($ USD)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rag_cost_usd_total)",
          "legendFormat": "Total Spend",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 6,
      "title": "Multi-Tier Cache Hit Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(rag_cache_events_total{event=\"hit\"}[1m])) / sum(rate(rag_cache_events_total[1m]))) * 100",
          "legendFormat": "Hit Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      }
    }
  ],
  "refresh": "5s",
